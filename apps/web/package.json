{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "extract-messages": "formatjs extract 'src/**/*.{ts,tsx}' --out-file src/locales/en.extracted.json --flatten",
    "check-messages": "formatjs extract 'src/**/*.{ts,tsx}' --flatten | node --experimental-strip-types scripts/check-messages.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@mtt/contracts": "workspace:*",
    "@mtt/ui": "workspace:*",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.89.0",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^9.2.4",
    "cobe": "^0.6.5",
    "fumadocs-core": "^16.17.3",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.3",
    "nitro": "3.0.260903-beta",
    "nuqs": "^2.10.1",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-intl": "^12.1.1",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.30",
    "@mtt/tsconfig": "workspace:^",
    "@tailwindcss/vite": "^4.1.13",
    "@types/geojson": "^7946.0.16",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
