# Copy to .env for `pnpm dev`. Docker Compose builds take theirs from the repo-root .env.
VITE_API_URL=http://localhost:8787

# Against a local API instead of apps/api-mock: set VITE_API_URL=http://localhost and
# uncomment this to skip launching the mock from `pnpm dev` and hide the mock-only
# "sample accounts" hint on the login page.
# VITE_DISABLE_MOCK_API=true
