:80 {
	# Vite emits files at the root of dist and absolute /start/… URLs. `/start` (no slash) redirects.
	@bare path /start
	redir @bare /start/ 308
	handle_path /start/* {
		root * /srv
		# A missing asset is a 404, not the page: a tab left open across a deploy then
		# fails to load an old chunk cleanly instead of parsing HTML as a script.
		@asset path /assets/*
		handle @asset {
			file_server
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
