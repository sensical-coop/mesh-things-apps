{
  "name": "meshtastic-things-apps",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "[ -f .env ] && . ./.env; F=\"--filter=web --filter=docs\"; [ \"$VITE_DISABLE_MOCK_API\" = \"true\" ] || F=\"$F --filter=api-mock\"; turbo run dev $F",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:css && pnpm lint:classes",
    "test": "turbo run test",
    "openapi:sync": "pnpm --filter @mtt/contracts openapi:sync && pnpm --filter @mtt/contracts openapi:generate",
    "openapi:generate": "pnpm --filter @mtt/contracts openapi:generate",
    "shadcn": "pnpm dlx shadcn@latest --cwd apps/web",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\"",
    "lint:classes": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.13",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "zod@>=4.0.0 <4.6.6": "4.6.6",
      "source-map-js@<1.2.2": "1.2.2",
      "minimatch@<11.0.1": "^11.0.1",
      "@hey-api/json-schema-ref-parser>js-yaml": "4.3.2"
    }
  }
}
