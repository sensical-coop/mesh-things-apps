{$SITE_ADDRESS} {
	# The docs app is rooted at /. /docs on this host only redirects there.
	redir /docs {$DOCS_URL}/ 308
	redir /docs/ {$DOCS_URL}/ 308
	handle_path /docs/* {
		redir {$DOCS_URL}{uri} 308
	}

	reverse_proxy web:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
