{$SITE_ADDRESS} {
	# The docs app is built with /docs as its base, so the path is passed on unchanged.
	# `/docs*` would also match `/docs-foo`, which belongs to the web app.
	@docs path /docs /docs/*
	handle @docs {
		reverse_proxy docs:80
	}

	reverse_proxy web:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
