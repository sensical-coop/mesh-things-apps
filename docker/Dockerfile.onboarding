# Onboarding SPA, served at /start. From repo root:
# docker build -f docker/Dockerfile.onboarding -t mtt-onboarding .
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY scripts ./scripts
COPY apps ./apps
COPY packages ./packages
RUN corepack prepare pnpm@10.6.1 --activate && pnpm install --frozen-lockfile
ARG VITE_API_URL
ARG VITE_DISABLE_MOCK_API=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_DISABLE_MOCK_API=$VITE_DISABLE_MOCK_API
RUN pnpm --filter onboarding build

FROM caddy:2-alpine
COPY --from=build /app/apps/onboarding/dist /srv
COPY docker/Caddyfile.onboarding /etc/caddy/Caddyfile
EXPOSE 80
