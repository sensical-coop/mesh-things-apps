{
  "name": "meshtastic-things-apps",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=api-mock",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "openapi-ts": "pnpm --filter @mtt/contracts openapi-ts",
    "shadcn": "pnpm dlx shadcn@latest --cwd apps/web"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.1",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
