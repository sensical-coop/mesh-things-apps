#!/bin/sh
# mesh-things-apps pre-commit
set -eu

cd "$(git rev-parse --show-toplevel)"

# Lint the staged blob. A partial stage must not be judged by unstaged edits.
git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' file; do
  case "$file" in
    *.css)
      git show ":$file" | pnpm exec stylelint --stdin --stdin-filename "$file"
      ;;
    *.tsx|*.jsx)
      git show ":$file" | pnpm exec eslint --stdin --stdin-filename "$file"
      ;;
  esac
done
