# Product docs (TanStack Start + Nitro). From repo root:
# docker build -f docker/Dockerfile.docs -t mtt-docs .
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages
RUN corepack prepare pnpm@10.6.1 --activate && pnpm install --frozen-lockfile
ARG VITE_WEB_URL=http://localhost:5173
ENV VITE_WEB_URL=$VITE_WEB_URL
RUN pnpm --filter docs build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/apps/docs/.output ./.output
ENV NODE_ENV=production
ENV PORT=80
ENV HOST=0.0.0.0
EXPOSE 80
CMD ["node", ".output/server/index.mjs"]
