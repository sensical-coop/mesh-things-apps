# Backend API
VITE_API_URL=https://api.yourdomain.com
# Public hostname
SITE_ADDRESS=app.yourdomain.com

# Public origins. Compose does not default these: a production build must not
# send visitors to localhost. Local values below are for this machine only.
# Docs header (logo + Docs) links to the web app. Baked into the docs image.
VITE_WEB_URL=http://localhost:5173
# Caddy redirects the site's /docs to the docs app root. No trailing slash.
DOCS_URL=http://localhost:5175

# Local dev against a real API instead of apps/api-mock: set VITE_API_URL above
# to that API's URL and uncomment this to skip launching the mock from
# `pnpm dev` and hide the mock-only "sample accounts" hint on the login page.
# VITE_DISABLE_MOCK_API=true

# Local Docker dev only (never on the VPS): make `docker compose up -d web` run the
# Vite dev server on the mounted source, with hot reload, instead of the production
# image. See docker-compose.dev.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
